{
  "name": "@webgado/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Banco do Web Gado: esquema Drizzle, migrações, dados iniciais e as consultas usadas pelo site e pela API.",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/scripts/migrar.ts",
    "seed": "tsx src/scripts/semear.ts",
    "reset": "tsx src/scripts/resetar.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@webgado/core": "*",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15"
  }
}
